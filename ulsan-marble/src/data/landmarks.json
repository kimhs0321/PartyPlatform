{
  "id": "ulsan_marble_regional_landmarks",
  "version": 2,
  "rules": {
    "definition": {
      "normalLandmarkStage": "모든 일반 부동산이 도달할 수 있는 최종 개발 단계",
      "regionalLandmark": "지정 대표 부동산이 LANDMARK 단계에 도달하고 권역 개발권 조건을 충족했을 때 활성화되는 권역 특수 효과"
    },
    "activationConditions": [
      "플레이어가 대표 랜드마크 부동산을 소유해야 한다.",
      "대표 랜드마크 부동산이 LANDMARK 단계여야 한다.",
      "플레이어가 해당 권역의 requiredOwnedProperties 이상을 소유해야 한다."
    ],
    "deactivationConditions": [
      "대표 랜드마크 소유권을 잃은 경우",
      "권역 소유 수가 requiredOwnedProperties 미만으로 감소한 경우",
      "대표 랜드마크 단계가 LANDMARK 미만으로 하락한 경우"
    ],
    "commonEffects": {
      "districtBaseTollMultiplier": 1.1,
      "festivalDistrictTollMultiplier": 1.2,
      "touristPaymentMultiplier": 1.25
    },
    "effectCalculation": {
      "normalDistrictToll": "baseToll * districtBaseTollMultiplier",
      "festivalDistrictToll": "baseToll * districtBaseTollMultiplier * festivalDistrictTollMultiplier",
      "touristPayment": "finalToll * touristPaymentMultiplier"
    },
    "touristNpcRules": {
      "spawnPosition": 0,
      "turnOrder": "LAST_PLAYER_AFTER",
      "diceCount": 2,
      "extraTurnOnDouble": false,
      "activatesSpecialTiles": false,
      "paysTollOnOwnedProperty": true,
      "disappearsAfterCompletingOneLap": true,
      "maximumActiveTourists": 1,
      "newFestivalWhileTouristActive": "KEEP_CURRENT_TOURIST"
    },
    "stackingRules": {
      "districtBaseTollMultiplier": "정책·뉴스·축제 효과와 곱연산",
      "festivalDistrictTollMultiplier": "해당 권역 축제 기간에만 적용",
      "touristPaymentMultiplier": "활성 대표 랜드마크 권역 부동산에 관광객이 도착했을 때만 적용"
    }
  },
